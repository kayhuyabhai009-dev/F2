#!/usr/bin/env bash
# jadx driver.
#   * if an official jadx CLI jar was imported (vendor/jadx-*-all.jar) -> use it
#   * otherwise fall back to the modern jadx-core jar that ships inside the
#     `jadx-mcp` npm package, driven through jadx.api.JadxDecompiler
#     (the official release zip is a blocked GitHub release asset here).
#
# Usage: jadx <input.apk|classes.dex> <outdir> [nores]
set -euo pipefail
TOOLS_DIR="${TOOLS_DIR:-/opt/tools}"
JAVA="${JAVA_HOME:-$TOOLS_DIR/jdk17/jre}/bin/java"

if [ -f "$TOOLS_DIR/jadx/jadx-all.jar" ]; then
  exec "$JAVA" -Xmx4g -jar "$TOOLS_DIR/jadx/jadx-all.jar" "$@"
fi

if [ $# -lt 2 ]; then echo "usage: jadx <input.apk|input.dex> <outdir> [nores]" >&2; exit 2; fi
CP="$TOOLS_DIR/jadx/wrapper:$TOOLS_DIR/jadx/jadx-core-modern.jar"
exec "$JAVA" -Xmx2g -cp "$CP" JadxRunner "$@"
